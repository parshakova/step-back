{
    "dataset": "cifar10",
    "model": "resnet20",
    "model_kwargs": {"batch_norm": true},
    "loss_func": "cross_entropy",
    "score_func": "cross_entropy_accuracy",
    "opt": [
        {"name": "muon", "lr": [1e-4, 3e-4, 1e-3, 3e-3, 1e-2], "weight_decay": 0, "momentum": 0.95, "ns_steps": 5, "lr_schedule": "constant"},
        {"name": "spectral-clip", "lr": [1e-4, 3e-4, 1e-3, 3e-3, 1e-2], "weight_decay": 0, "momentum": 0.95, "lr_schedule": "constant"},
        {"name": "adamw", "lr": [1e-4, 3e-4, 1e-3, 3e-3, 1e-2], "weight_decay": 0, "lr_schedule": "constant"},
        {"name": "sgd-m", "lr": [0.01, 0.03, 0.1, 0.3, 1.0], "weight_decay": 0, "momentum": 0.9, "dampening": 0.9, "lr_schedule": "constant"},
        {"name": "spectral-inv", "lr": [1e-4, 3e-4, 1e-3, 3e-3, 1e-2], "weight_decay": 0, "momentum": 0.95, "lr_schedule": "constant"}
    ],
    "batch_size": 128,
    "max_epoch": 50,
    "n_runs": 1
}